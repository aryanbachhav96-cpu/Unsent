# Server configuration
PORT=5000
NODE_ENV=development

# Authentication & Security secrets
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
IP_SALT_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Optional local admin seed (required when NODE_ENV=production)
ADMIN_EMAIL=replace-with-admin-email
ADMIN_PASSWORD=replace-with-a-unique-password
ADMIN_HANDLE=replace-with-admin-handle
